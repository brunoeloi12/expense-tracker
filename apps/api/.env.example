# Copy this file to `.env` and replace the placeholders with your real values.
# NEVER commit the .env file to version control.

# PostgreSQL connection string (requires PostgreSQL >= 15)
DATABASE_URL="postgresql://user:password@localhost:5432/fincontrol?schema=public"

# Redis connection string
REDIS_URL="redis://localhost:6379"

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# Cookie signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=""

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL="http://localhost:3000"

# Server port
PORT=3001

# Environment: development | production
NODE_ENV="development"
